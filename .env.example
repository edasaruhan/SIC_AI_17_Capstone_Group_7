GP_ENVIRONMENT=development
GP_AUTH_MODE=development
# Run scripts/local_setup.py to generate unique local secrets and scoped database URLs.
GP_DATABASE_URL=postgresql+psycopg://growthpilot_app:CHANGE_ME@127.0.0.1:55432/growthpilot
GP_MIGRATION_DATABASE_URL=postgresql+psycopg://growthpilot_migrator:CHANGE_ME@127.0.0.1:55432/growthpilot
GP_DEV_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GP_REDIS_URL=redis://127.0.0.1:56379/0
GP_OBJECT_ROOT=.local/objects
GP_ALLOWED_ORIGINS=["http://localhost:3000"]
# Production: GP_AUTH_MODE=oidc and set issuer, audience, trusted HTTPS JWKS URL.
